{
  "rules": {
    ".read": true,
    ".write": "auth != null",
    "deals": {
      ".indexOn": [
        "price",
        "discount",
        "category",
        "id",
        "date",
        "asin",
        "productCode",
        "datetime",
        "sourceType",
        "categoryKey",
        "categoryGroup",
        "hierarchicalCategory/subcategory",
        "storeType"
      ]
    },
    "productdeals": {
      ".indexOn": [
        "price",
        "discount",
        "category",
        "id",
        "date",
        "asin",
        "productCode",
        "datetime",
        "sourceType",
        "categoryKey",
        "categoryGroup",
        "hierarchicalCategory/subcategory",
        "storeType"
      ],
      "$id": {
        ".read": true,
        ".write": true
      }
    },
    "productdeals_static": {
      ".indexOn": [
        "staticCategory",
        "categoryGroup",
        "staticSubcategory",
        "staticStyle"
      ],
      "$id": {
        ".read": true,
        ".write": true
      }
    },
    "banners": {
      ".indexOn": [
        "active",
        "order",
        "category",
        "isActive",
        "platform"
      ]
    },
    "test-banners": {
      ".indexOn": [
        "active",
        "order",
        "category",
        "isActive"
      ]
    }
  }
}